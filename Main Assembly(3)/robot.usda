            point3f physics:localPos1 = (-1.2299114e-18, 0.002, -1.9186618e-16)
            quatf physics:localRot1 = (0.70710677, 0.70710677, -0, -0)
            bool physxArticulation:enabledSelfCollisions = 0
        }
    }

    def Scope "links"
    {
        def Xform "_MSDcq3wvBIfc42pCk" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "IsaacLinkAPI", "PhysicsMassAPI"]
            displayName = "Battery <1>"
        )
        {
            string isaac:nameOverride
            quatf physics:principalAxes = (0.48938867, 0.5102904, -0.5103766, -0.48950812)
            float3 physics:diagonalInertia = (0.0001449816, 0.0008498833, 0.00085001613)
            float physics:mass = 0.5599915
