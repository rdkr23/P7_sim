            quatf physics:localRot0 = (0.70710677, -0.70710677, -0, -0)
            rel physics:body1 = </robot/links/_MLCSoh7Z7efrRtEb7>
            point3f physics:localPos1 = (0.0135, 0.002, -0.068)
            quatf physics:localRot1 = (0.70710677, 0.70710677, -0, -0)
            bool physxArticulation:enabledSelfCollisions = 0
