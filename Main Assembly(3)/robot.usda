            prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
            displayName = "Fastened 3"
        )
        {
            rel physics:body0 = </robot/links/_Mud6IxQksMM3dDWNT>
            point3f physics:localPos0 = (0, 0, 0.089)
            quatf physics:localRot0 = (1, 0, -0, -0)
            rel physics:body1 = </robot/links/_MLCSoh7Z7efrRtEb7>
            point3f physics:localPos1 = (0, 0, 0.125)
            quatf physics:localRot1 = (0.70710677, 0, -0, 0.70710677)
